# Copy this file to .env. Keep .env private; never commit real credentials.
# Hosted is the safe default: set OAuth credentials and administrator email before starting.
# Local-only test: set JANKO_HOSTED=false, leave tunnel disabled, use http://127.0.0.1:8000.

JANKO_HOSTED=true
JANKO_PUBLIC_URL=https://choir.example.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
JANKO_DRIVE_ROOT_ID=
JANKO_ADMIN_EMAILS=
JANKO_ALLOWED_EMAILS=
JANKO_SESSION_DAYS=7

# Used only with: docker compose --profile tunnel up -d
CLOUDFLARE_TUNNEL_TOKEN=

# Optional build/runtime tuning
AUDIVERIS_VERSION=5.11.0
AUDIVERIS_TIMEOUT=900
